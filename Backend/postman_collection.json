    {
      "name": "Field Mappings",
      "description": "APIs for creating, reading, updating, validating, and deleting dataset field mapping configurations stored in MongoDB",
      "item": [
        {
          "name": "Create Field Mapping",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Mapping created successfully with ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.mapping).to.have.property(\"mappingId\");",
                  "    pm.environment.set(\"mappingId\", jsonData.mapping.mappingId);",
                  "    pm.environment.set(\"datasetId\", jsonData.mapping.datasetId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datasetId\": \"{{datasetId}}\",\n  \"name\": \"Alpha Sales Field Mapping\",\n  \"description\": \"Field mapping from alpha sales source columns to standard target schema\",\n  \"fieldMappings\": [\n    {\n      \"sourceField\": \"product\",\n      \"targetField\": \"product_name\",\n      \"targetType\": \"string\",\n      \"transformation\": \"trim\",\n      \"isRequired\": true\n    },\n    {\n      \"sourceField\": \"price\",\n      \"targetField\": \"unit_price\",\n      \"targetType\": \"number\",\n      \"transformation\": \"to_number\",\n      \"isRequired\": true\n    },\n    {\n      \"sourceField\": \"category\",\n      \"targetField\": \"category_code\",\n      \"targetType\": \"string\",\n      \"transformation\": \"uppercase\",\n      \"defaultValue\": \"GENERAL\"\n    }\n  ],\n  \"targetRole\": {\n    \"target\": \"unit_price\",\n    \"id\": \"id\",\n    \"numerical\": [\n      \"price\"\n    ],\n    \"categorical\": [\n      \"product\",\n      \"category\"\n    ]\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/mappings",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5001",
              "path": [
                "api",
                "mappings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Field Mapping by Dataset ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Mapping returned for dataset\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.mapping).to.be.an(\"object\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/mappings/:datasetId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5001",
              "path": [
                "api",
                "mappings",
                ":datasetId"
              ],
              "variable": [
                {
                  "key": "datasetId",
                  "value": "{{datasetId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Field Mapping",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Mapping updated successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.mapping.name).to.include(\"Updated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alpha Sales Field Mapping - Updated\",\n  \"description\": \"Updated field mapping configurations with custom types and transformations\",\n  \"fieldMappings\": [\n    {\n      \"sourceField\": \"product\",\n      \"targetField\": \"product_title\",\n      \"targetType\": \"string\",\n      \"transformation\": \"trim\",\n      \"isRequired\": true\n    },\n    {\n      \"sourceField\": \"price\",\n      \"targetField\": \"final_price\",\n      \"targetType\": \"number\",\n      \"transformation\": \"to_number\",\n      \"isRequired\": true\n    },\n    {\n      \"sourceField\": \"id\",\n      \"targetField\": \"sku_id\",\n      \"targetType\": \"string\",\n      \"transformation\": \"trim\",\n      \"isRequired\": true\n    }\n  ],\n  \"targetRole\": {\n    \"target\": \"final_price\",\n    \"id\": \"id\",\n    \"numerical\": [\n      \"price\"\n    ],\n    \"categorical\": [\n      \"product\"\n    ]\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/mappings/:datasetId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5001",
              "path": [
                "api",
                "mappings",
                ":datasetId"
              ],
              "variable": [
                {
                  "key": "datasetId",
                  "value": "{{datasetId}}"
                }
              ]
            }
          },
          "response": []
        },
