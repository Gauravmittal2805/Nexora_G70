{
  "info": {
    "name": "Nexora Backend APIs",
    "description": "Collection for testing Nexora Auth, Health, and Dataset Management APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gaurav Mittal\",\n  \"email\": \"gaurav@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gaurav@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5001/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Datasets",
      "item": [
        {
          "name": "Upload Dataset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "name",
                  "value": "Customer Churn Analysis",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Historical customer metrics and churn indicators",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "customers, churn, analytics",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5001/api/datasets/upload",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "List Datasets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/datasets?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Dataset By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/datasets/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "dataset_id_here"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Dataset Preview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/datasets/:id/preview?limit=20",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets", ":id", "preview"],
              "query": [
                { "key": "limit", "value": "20" }
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "dataset_id_here"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Dataset Download URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/datasets/:id/download",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets", ":id", "download"],
              "variable": [
                {
                  "key": "id",
                  "value": "dataset_id_here"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Dataset",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5001/api/datasets/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "datasets", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "dataset_id_here"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
